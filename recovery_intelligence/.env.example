# LLM API Keys & Model Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_API_KEY=

# Feature Flags Override
ENABLE_FAISS=true
ENABLE_PRESIDIO_YARA=true
ENABLE_SENTENCE_TRANSFORMER=true
ENABLE_LLM=false
ENABLE_GRAPHVIZ=true

# Storage Paths
EVIDENCE_DIR=./evidence
RECOVERED_DIR=./recovered
CACHE_DIR=./cache
RESULTS_DIR=./results
